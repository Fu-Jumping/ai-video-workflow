{
  "adapterId": "obsidian",
  "displayName": "Obsidian",
  "inputs": [
    "project.config.yaml",
    "01_概念策划/",
    "02_世界设定/",
    "03_分镜脚本/",
    "04_图片提示词/",
    "05_视频提示词/",
    "06_执行计划/"
  ],
  "outputs": [
    "_views/obsidian/流程/",
    "_views/obsidian/镜头/",
    "_views/obsidian/数据表/",
    "_views/obsidian/画布/",
    "_views/obsidian/投影清单.json"
  ],
  "syncDirection": "one-way-project-to-adapter",
  "sourceOfTruth": "project-step-files",
  "sharedEntryPoints": [
    "AGENTS.md",
    "文档/智能体工作区/入口说明.md",
    "文档/智能体工作区/边界说明.md"
  ],
  "generatedSurfaces": [
    "_views/obsidian/"
  ],
  "userOwnedSurfaces": [
    "_views/obsidian/笔记/"
  ],
  "privateRuntimeSurfaces": [
    ".obsidian/",
    "_views/obsidian/.obsidian/"
  ],
  "handoffSurfaces": [
    "_views/obsidian/04_智能体交接.md",
    "_views/obsidian/镜头/",
    "_views/obsidian/画布/"
  ],
  "verificationCommands": [
    "ai-video-workflow export-obsidian --project <path> --in-project-view",
    "ai-video-workflow verify-obsidian --project <path> --in-project-view"
  ],
  "forbiddenWrites": [
    "_views/obsidian/流程/",
    "_views/obsidian/镜头/",
    "_views/obsidian/数据表/",
    "_views/obsidian/画布/",
    "_views/obsidian/投影清单.json",
    "_views/obsidian/.obsidian/",
    ".obsidian/",
    "absolute links"
  ],
  "failureBehavior": "Refresh the generated view from Step source files; preserve user notes under _views/obsidian/笔记/ and never reverse-sync generated projection files into project truth."
}
